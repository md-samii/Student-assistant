# Database configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/student_assistant?schema=public"

# Server configuration
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# JWT Authentication
JWT_SECRET="your_jwt_secret_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Google OAuth (Optional for Google Sign-In)
GOOGLE_CLIENT_ID=""

# Gemini AI (For AI Assistant and Practice Quizzes)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash"

# YouTube Data API v3 (For Academic Video Recommendations)
# Get a key from Google Cloud Console: Enable "YouTube Data API v3" and create an API Key.
YOUTUBE_API_KEY="your_youtube_api_key_here"

# Adzuna Jobs API (Optional for live Indian tech job & internship discovery)
# Register at https://developer.adzuna.com to get App ID and Key for Indian market.
ADZUNA_APP_ID="your_adzuna_app_id_here"
ADZUNA_APP_KEY="your_adzuna_app_key_here"

