generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  passwordHash          String?
  fullName              String
  googleId              String?  @unique
  role                  UserRole @default(STUDENT)
  isActive              Boolean  @default(true)
  dailyStudyGoalMinutes Int      @default(240)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  profile            StudentProfile?
  chatHistories      ChatHistory[]
  documents          Document[]
  quizSubmissions    QuizSubmission[]
  createdQuizzes     Quiz[]              @relation("QuizCreator")
  skills             Skill[]
  projects           Project[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  learningActivities LearningActivity[]
  studySessions      StudySession[]
  activeStudySession ActiveStudySession?
  videoProgress      VideoProgress[]
  resumeAnalyses     ResumeAnalysis[]
  opportunityApplications OpportunityApplication[]

  @@map("users")
}

model StudentProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  university     String
  degree         String
  branch         String
  semester       Int
  section        String?
  graduationYear Int
  phone          String?
  profilePicture String?
  bio            String?
  githubUrl      String?
  linkedinUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_profiles")
}

model Subject {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  university  String
  branch      String
  semester    Int
  description String?

  resources       StudyResource[]
  quizzes         Quiz[]
  quizSubmissions QuizSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subjects")
}

model StudyResource {
  id           String          @id @default(uuid())
  title        String
  description  String?
  subjectId    String
  subject      Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  moduleNumber Int
  type         String // PDF_NOTES, PPT, TUTORIAL, PREVIOUS_PAPER, LAB_MANUAL, CODING_EXERCISE
  driveUrl     String // Google Drive shareable link
  fileSize     String?
  uploadedBy   String
  chunks       ResourceChunk[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("study_resources")
}

model Quiz {
  id          String  @id @default(uuid())
  title       String
  description String?
  subjectId   String
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  creatorId String?
  creator   User?   @relation("QuizCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  moduleNumber Int?
  timeLimitMin Int?
  totalMarks   Int

  questions   QuizQuestion[]
  submissions QuizSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@map("quizzes")
}

model QuizQuestion {
  id            String  @id @default(uuid())
  quizId        String
  quiz          Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText  String
  options       String // JSON stringified array of options
  correctOption Int // 0-indexed
  explanation   String?

  @@map("quiz_questions")
}

model QuizSubmission {
  id          String   @id @default(uuid())
  quizId      String?
  quiz        Quiz?    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Int
  totalMarks  Int
  answers     String // JSON stringified answers
  submittedAt DateTime @default(now())

  // Fields for on-demand practice attempts (where quiz is temporary and not persisted)
  subjectId    String?
  subject      Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  moduleNumber Int?
  timeTakenSec Int?
  isPractice   Boolean  @default(false)

  @@index([userId, submittedAt])
  @@map("quiz_submissions")
}

model ChatHistory {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      String?
  question     String
  answer       String
  isBookmarked Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("chat_histories")
}

model Document {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  type        String // RESUME, CERTIFICATE, MARKS_CARD, INTERNSHIP_CERTIFICATE
  fileUrl     String // Firebase Storage URL
  storagePath String // Firebase path
  fileSize    Int
  mimeType    String
  fileData    Bytes?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resumeAnalyses ResumeAnalysis[]

  @@map("documents")
}

model Skill {
  id          String  @id @default(uuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  proficiency String? // Beginner, Intermediate, Advanced

  createdAt DateTime @default(now())

  @@map("skills")
}

model Project {
  id          String  @id @default(uuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  techStack   String // JSON stringified array
  githubUrl   String?
  liveUrl     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projects")
}

model Internship {
  id          String    @id @default(uuid())
  title       String
  company     String
  location    String
  stipend     String?
  duration    String
  applyUrl    String
  description String
  deadline    DateTime?
  status      String    @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("internships")
}

model Job {
  id          String    @id @default(uuid())
  title       String
  company     String
  location    String
  package     String?
  applyUrl    String
  description String
  deadline    DateTime?
  status      String    @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("jobs")
}

model GovernmentExam {
  id          String    @id @default(uuid())
  title       String
  organizer   String
  eligibility String
  examDate    DateTime?
  applyUrl    String
  description String
  status      String    @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("government_exams")
}

model Notification {
  id      String  @id @default(uuid())
  userId  String? // null means broadcast to all users
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   String
  message String
  type    String // ACADEMIC, QUIZ, CAREER, GENERAL
  isRead  Boolean @default(false)
  linkUrl String?

  createdAt DateTime @default(now())

  @@map("notifications")
}

model AuditLog {
  id        String  @id @default(uuid())
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  ipAddress String?
  details   String?

  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model LearningActivity {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("learning_activities")
}

model StudySession {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt       DateTime
  endedAt         DateTime
  durationMinutes Int
  createdAt       DateTime @default(now())

  @@index([userId, startedAt])
  @@map("study_sessions")
}

model ActiveStudySession {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime
  createdAt DateTime @default(now())

  @@map("active_study_sessions")
}

model ResourceChunk {
  id         String        @id @default(uuid())
  resourceId String
  resource   StudyResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  chunkIndex Int
  content    String @db.Text

  createdAt DateTime @default(now())

  @@unique([resourceId, chunkIndex])
  @@index([resourceId])
  @@map("resource_chunks")
}

model VideoProgress {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  youtubeVideoId String
  title          String
  thumbnailUrl   String?
  channelTitle   String?
  subjectCode    String?
  moduleNumber   Int?
  status         String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  isFavorite     Boolean  @default(false)
  lastWatchedAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, youtubeVideoId])
  @@index([userId, status])
  @@index([userId, isFavorite])
  @@map("video_progress")
}

model Opportunity {
  id               String    @id @default(uuid())
  provider         String    // 'ADZUNA', 'GREENHOUSE', 'CAMPUS_VTU', 'GOVT_NATIONAL_PORTAL'
  externalId       String?   // External listing ID from provider
  title            String
  company          String
  logoUrl          String?
  category         String    // 'INTERNSHIP' | 'JOB' | 'GOVT_EXAM'
  description      String    @db.Text
  requiredSkills   String    @db.Text // JSON stringified array
  preferredSkills  String?   @db.Text // JSON stringified array
  eligibleBranches String?   @db.Text // JSON stringified array
  eligibleSemesters String?  @db.Text // JSON stringified array
  location         String
  isRemote         Boolean   @default(false)
  employmentType   String    @default("FULL_TIME") // 'FULL_TIME' | 'INTERNSHIP' | 'PART_TIME' | 'CONTRACT'
  salaryRange      String?   // Verified salary/stipend or null
  applyUrl         String
  deadline         DateTime?
  postedAt         DateTime?
  firstSeenAt      DateTime  @default(now())
  lastCheckedAt    DateTime  @default(now())
  status           String    @default("ACTIVE") // 'ACTIVE' | 'STALE' | 'EXPIRED'
  sourceProvenance String?   @db.Text // Source notes, attribution, or feed details
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  applications     OpportunityApplication[]

  @@unique([provider, externalId])
  @@index([category, status])
  @@index([lastCheckedAt])
  @@map("opportunities")
}

model OpportunitySyncLog {
  id           String   @id @default(uuid())
  provider     String
  status       String   // 'SUCCESS' | 'PARTIAL' | 'FAILED'
  itemsFetched Int      @default(0)
  itemsCreated Int      @default(0)
  itemsUpdated Int      @default(0)
  message      String?  @db.Text
  startedAt    DateTime @default(now())
  completedAt  DateTime @default(now())

  @@index([provider, startedAt])
  @@map("opportunity_sync_logs")
}

model OpportunityApplication {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  appliedAt     DateTime    @default(now())
  status        String      @default("SUBMITTED")

  @@unique([userId, opportunityId])
  @@index([userId])
  @@map("opportunity_applications")
}

model ResumeAnalysis {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId         String?
  document           Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  resumeName         String
  extractedText      String    @db.Text
  pageCount          Int       @default(1)

  // Overall & Rubric Scores (0 - 100)
  overallScore       Int
  parsingScore       Int       // Parsing & formatting quality (max 20)
  sectionScore       Int       // Completeness & clarity of sections (max 25)
  skillsScore        Int       // Relevance & depth of skills (max 20)
  experienceScore    Int       // Quality of projects & experience (max 25)
  formattingScore    Int       // ATS structure & readability (max 10)

  // Detailed Extraction (JSON stringified)
  contactInfo        String    @db.Text
  summary            String?   @db.Text
  education          String    @db.Text
  skills             String    @db.Text
  experience         String    @db.Text
  projects           String    @db.Text
  certifications     String    @db.Text

  // Actionable Improvement Report (JSON stringified)
  issues             String    @db.Text

  // ATS Checklist (JSON stringified)
  checklist          String    @db.Text

  // Optional Target Job Alignment
  targetJobTitle     String?
  targetJobDesc      String?   @db.Text
  targetMatchScore   Int?
  targetMatchDetails String?   @db.Text

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId, createdAt])
  @@map("resume_analyses")
}

